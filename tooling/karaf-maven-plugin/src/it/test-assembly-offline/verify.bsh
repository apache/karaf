import java.io.*;

// the offline build created the assembly from the local repository
if (!new File(basedir, "target/assembly/system").isDirectory()) {
    throw new IllegalStateException("The offline assembly was not created");
}

// the offline build with the missing bundle did not download it
File missing = new File(localRepositoryPath, "org/apache/commons/commons-csv/1.12.0/commons-csv-1.12.0.jar");
if (missing.exists()) {
    throw new IllegalStateException("The offline build downloaded " + missing);
}

// the offline build with the missing bundle failed because it was offline
boolean offline = false;
for (String line : java.nio.file.Files.readAllLines(new File(basedir, "build.log").toPath(), java.nio.charset.StandardCharsets.ISO_8859_1)) {
    if (line.contains("offline mode") && line.contains("commons-csv:jar:1.12.0")) {
        offline = true;
    }
}
if (!offline) {
    throw new IllegalStateException("The offline build with the missing bundle did not fail for being offline");
}

return true;
