import java.io.*;
import java.lang.*;
import java.util.zip.*;

// check that the kar archive has been created next to the bundle, without classifier
File kar = new File(basedir, "target/test-kar-bundle-packaging-1.0-SNAPSHOT.kar");
if (!kar.exists()) {
    return false;
}

// check that the features XML and the project bundle are in the same directory of the kar
String path = "repository/test/test-kar-bundle-packaging/1.0-SNAPSHOT/test-kar-bundle-packaging-1.0-SNAPSHOT";
ZipFile zip = new ZipFile(kar);
boolean found = zip.getEntry(path + "-features.xml") != null && zip.getEntry(path + ".jar") != null;
zip.close();

return found;
